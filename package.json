{
  "name": "@takumi0706/google-calendar-mcp",
  "version": "2.0.0",
  "description": "Google Calendar MCP server for Claude Desktop integration with enhanced security",
  "main": "dist/index.js",
  "bin": {
    "google-calendar-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "dev": "pnpm run build && pnpm start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "tsc --project tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check-circular": "node scripts/check-circular-deps.js",
    "check-stdio": "node scripts/check-stdout-purity.js",
    "security": "pnpm audit && pnpm run lint",
    "validate": "pnpm run typecheck && pnpm run test:types && pnpm run lint && pnpm test && pnpm run check-circular",
    "prepublishOnly": "pnpm run validate && pnpm run build && pnpm run check-stdio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takumi0706/google-calendar-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/takumi0706/google-calendar-mcp/issues"
  },
  "homepage": "https://github.com/takumi0706/google-calendar-mcp#readme",
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "google-calendar",
    "calendar",
    "claude-desktop",
    "ai-integration",
    "secure"
  ],
  "author": "takumi0706",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "10.5.0",
    "googleapis": "^174.0.1",
    "hono": "^4.13.2",
    "open": "^11.0.1",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "jws@4.0.0": "^4.0.1",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.9",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "qs@>=6.11.1 <6.15.2": "^6.15.3"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
