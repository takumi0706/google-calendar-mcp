{
  "name": "@takumi0706/google-calendar-mcp",
  "version": "1.0.7",
  "description": "Google Calendar MCP server for Claude Desktop integration with enhanced security",
  "main": "dist/index.js",
  "bin": {
    "google-calendar-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "dev": "pnpm run build && pnpm start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "tsc --project tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check-circular": "node scripts/check-circular-deps.js",
    "security": "pnpm audit && pnpm run lint",
    "validate": "pnpm run typecheck && pnpm run test:types && pnpm run lint && pnpm test && pnpm run check-circular",
    "prepublishOnly": "pnpm run validate && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takumi0706/google-calendar-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/takumi0706/google-calendar-mcp/issues"
  },
  "homepage": "https://github.com/takumi0706/google-calendar-mcp#readme",
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "google-calendar",
    "calendar",
    "claude-desktop",
    "ai-integration",
    "secure"
  ],
  "author": "takumi0706",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.2",
    "@hono/oauth-providers": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "hono": "^4.6.3",
    "open": "^10.1.0",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
